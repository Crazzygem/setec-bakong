# Copy to .env.local and fill in. Every value here is a placeholder.
# With no BAKONG_TOKEN the app runs in demo mode: invoices settle through
# POST /api/invoices/[id]/simulate instead of a real transfer.

# --- Bakong Open API ---
# Get both from the Bakong developer portal. The token is a live secret.
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=

# --- Merchant identity ---
# Bakong ID sub-tag 00. Either a shared ID (khqr@aclb) or a personal one (name@aclb).
MERCHANT_BAKONG_ID=
# Sub-tag 01: account number for the individual layout, merchant ID for the merchant layout.
MERCHANT_ACCOUNT_INFO=
# Sub-tag 02. Required by the merchant layout.
MERCHANT_ACQUIRING_BANK=
# Default "individual" (account under tag 29). Set to "merchant" to use tag 30.
MERCHANT_KHQR_LAYOUT=individual
MERCHANT_NAME=
MERCHANT_CITY=

# --- The bank QR to copy from ---
# The receive-money QR text from ACLEDA mobile > My KHQR, decoded.
# When set, each bill copies this string byte for byte and adds only amount,
# bill number and expiry, so every account tag the bank routes on stays exact.
# Leave empty to build the QR from the MERCHANT_ fields above instead.
MERCHANT_KHQR_SOURCE=

# Must match the receiving account: a USD-only account rejects a KHR QR at account inquiry.
SHOP_CURRENCY=KHR

# Marks invoices paid without a transfer. Demo only. Forced off once BAKONG_TOKEN is set,
# unless you set this back to true on purpose.
SIMULATE_PAYMENTS=true

# --- Local paths ---
DATABASE_PATH=./data/app.db
# Pins printed room QR codes to one domain. Unset, the print page uses the address you loaded it from.
APP_URL=
# Lets a second build or server run beside npm run dev without sharing .next.
NEXT_DIST_DIR=.next
